{
  "$schema": "https://railway.app/railway.schema.json",
  "services": {
    "vantage-backend": {
      "build": {
        "builder": "DOCKER",
        "dockerfilePath": "backend/Dockerfile",
        "context": "backend"
      },
      "deploy": {
        "numReplicas": 1,
        "sleepService": false
      }
    },
    "vantage-frontend": {
      "build": {
        "builder": "DOCKER",
        "dockerfilePath": "frontend/Dockerfile",
        "context": "frontend"
      },
      "deploy": {
        "numReplicas": 1,
        "sleepService": false
      }
    }
  }
}