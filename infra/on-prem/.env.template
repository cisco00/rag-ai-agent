# =============================================================================
# Vantage AI — On-Prem Production Environment Template
#
# Copy this file to .env and fill in every value marked REQUIRED.
# This file is gitignored — NEVER commit .env with real secrets.
#
# Quick start:
#   cp .env.template .env
#   nano .env                          # fill in your values
#   docker compose -f docker-compose.prod.yml up -d
# =============================================================================


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  DOMAIN & TLS                                                           ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# REQUIRED — the domain your users will access (e.g. vantage.acme.com)
DOMAIN_NAME=vantage.example.com

# Email for Let's Encrypt certificate notifications
ACME_EMAIL=admin@example.com

# Ports (change only if something else is using 80/443)
HTTP_PORT=80
HTTPS_PORT=443


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  LLM PROVIDER                                                           ║
# ╚═══════════════════════════════════════════════════════════════════════════╝
# Supported: openai | azure_openai | anthropic | google | huggingface

# REQUIRED — choose your provider
LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-4o

# REQUIRED — API key for the selected provider
# For openai:        your OpenAI API key (sk-...)
# For azure_openai:  your Azure OpenAI key
# For anthropic:     your Anthropic API key
# For google:        set GOOGLE_API_KEY below instead
# For huggingface:   set HF_TOKEN below instead
LLM_API_KEY=

# --- Azure OpenAI (only when LLM_PROVIDER=azure_openai) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- Google Gemini (only when LLM_PROVIDER=google) ---
GOOGLE_API_KEY=

# --- HuggingFace (only when LLM_PROVIDER=huggingface) ---
HF_TOKEN=

# --- Fallback model (optional — automatically retries with this if primary fails) ---
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  DATABASE (Admin)                                                        ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# REQUIRED — PostgreSQL credentials for the admin database
# The compose file creates this database automatically.
POSTGRES_SYS_ADMIN_USER=postgres
POSTGRES_SYS_ADMIN_PASSWORD=
POSTGRES_DB=vantage_admin
POSTGRES_HOST=vantage-db
POSTGRES_PORT=5432


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  SECURITY                                                                ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# REQUIRED — generate with: openssl rand -base64 32
JWT_SECRET=

# REQUIRED — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  APPLICATION URLs                                                        ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# These are auto-derived from DOMAIN_NAME in most cases.
# Override only if your setup differs.
APP_URL=https://${DOMAIN_NAME}
CORS_ORIGINS=https://${DOMAIN_NAME}
FRONTEND_URL=https://${DOMAIN_NAME}
BACKEND_URL=http://vantage-backend:8000
CRM_CALLBACK_URL=https://${DOMAIN_NAME}/api/integrations/crm/callback


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  EMAIL / SMTP                                                            ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=Vantage AI


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  TOKEN / SESSION TUNING                                                  ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30
ALERT_CHECK_INTERVAL=5


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  OBSERVABILITY — Langfuse (optional)                                     ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  MONITORING (optional)                                                   ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# To enable Prometheus + Grafana + Node Exporter, run:
#   docker compose -f docker-compose.prod.yml --profile monitoring up -d

# Grafana admin password (default: changeme)
GRAFANA_ADMIN_PASSWORD=changeme

# Slow query alert threshold (ms)
SLOW_QUERY_MS=3000
SLOW_QUERY_EMAIL=


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  RESOURCE LIMITS                                                         ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# Adjust based on your server specs
BACKEND_MEMORY_LIMIT=2G
BACKEND_CPU_LIMIT=2.0


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  MISCELLANEOUS                                                           ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

CRM_MOCK_MODE=false
ENVIRONMENT=production
