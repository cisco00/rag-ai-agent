{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Vantage AI",
  "version": "2.6.0",
  "identifier": "com.vantageai.desktop",
  "build": {
    "frontendDist": "../../frontend/dist",
    "beforeBuildCommand": "",
    "beforeDevCommand": "cd ../frontend && npm run dev",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vantage AI — Beta",
        "width": 1280,
        "height": 800,
        "center": true,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/vantage-backend/vantage-backend"
    ],
    "resources": {
      "binaries/vantage-backend/": "vantage-backend/"
    },
    "category": "Business",
    "shortDescription": "AI-powered analytics platform",
    "longDescription": "Vantage AI is a self-hosted, AI-powered analytics platform that connects to your databases and provides natural language querying, automated insights, and interactive dashboards.",
    "copyright": "© 2026 Vantage AI",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "languages": ["English"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libssl3"]
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": true,
      "endpoints": [
        "https://github.com/cisco00/rag-ai-agent/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  }
}
