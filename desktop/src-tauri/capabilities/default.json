{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Vantage AI desktop app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-spawn",
    "shell:allow-execute",
    "shell:default",
    {
      "identifier": "shell:allow-sidecar",
      "allow": [
        {
          "name": "vantage-backend",
          "sidecar": true
        }
      ]
    },
    "dialog:default",
    "updater:default"
  ]
}
