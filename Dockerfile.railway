# Dockerfile.railway — single-stage build for Railway deployments
# The compiled frontend (frontend/dist) is committed to the repo so no
# Node.js build step is needed here. Railway only needs to run the Python
# backend and serve the pre-built static files.
FROM python:3.11-slim

WORKDIR /app

# System libraries required by Python deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    default-libmysqlclient-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY backend/requirements.txt .
RUN pip install --no-cache-dir --timeout=300 --retries=5 -r requirements.txt

# Copy backend source code
COPY backend/ .

# Copy the pre-built React frontend (committed to the repo via git add -f)
# api.py's get_static_dir() checks /app/frontend/dist as an absolute fallback
RUN mkdir -p /app/frontend/dist
COPY frontend/dist /app/frontend/dist

# Non-root user for security
RUN useradd --create-home --shell /bin/bash appuser && \
    chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

ENV PYTHONUNBUFFERED=1
ENV PORT=8000
ENV ENVIRONMENT=production
ENV LLM_PROVIDER=google
ENV LLM_MODEL_NAME=gemini-1.5-pro

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

CMD ["sh", "-c", "alembic upgrade head || echo '[WARN] DB migrations failed'; uvicorn api:app --host 0.0.0.0 --port ${PORT:-8000}"]
