# =============================================================================
# Vantage AI — Backend Environment Template
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to git. This template is safe to commit.
# =============================================================================

# ---------------------------------------------------------------------------
# LLM Provider
# Choose one: openai | azure_openai | anthropic | google | huggingface
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-4o

# Universal LLM API key — used for all providers except huggingface
# In AWS deployments this is injected from Secrets Manager automatically.
LLM_API_KEY=

# Azure OpenAI — only required when LLM_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Google Gemini — only required when LLM_PROVIDER=google
GOOGLE_API_KEY=

# HuggingFace — only required when LLM_PROVIDER=huggingface
HF_TOKEN=

# Fallback model (optional — used if primary provider fails)
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=

# ---------------------------------------------------------------------------
# PostgreSQL — System Admin (for multi-tenant provisioning)
# ---------------------------------------------------------------------------
POSTGRES_SYS_ADMIN_USER=postgres
POSTGRES_SYS_ADMIN_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Admin Database (SQLite for local dev, Postgres for production)
# ---------------------------------------------------------------------------
# For local dev, leave this commented out — SQLite is used automatically.
# DATABASE_URL=postgresql://user:password@host:5432/vantage_admin
# DIRECT_URL=postgresql://user:password@host:5432/vantage_admin

# ---------------------------------------------------------------------------
# Security — generate both with: openssl rand -base64 32
# ---------------------------------------------------------------------------
JWT_SECRET=
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# App URLs
# ---------------------------------------------------------------------------
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CRM_CALLBACK_URL=http://localhost:8000/integrations/crm/callback

# ---------------------------------------------------------------------------
# SMTP / Email
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=Vantage AI

# ---------------------------------------------------------------------------
# Token Lifetimes (optional tuning)
# ---------------------------------------------------------------------------
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30
ALERT_CHECK_INTERVAL=5

# ---------------------------------------------------------------------------
# Langfuse — LLM observability (optional)
# Get keys at https://cloud.langfuse.com or self-host
# ---------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------------------------------------------------------------------------
# Optional monitoring
# ---------------------------------------------------------------------------
SLOW_QUERY_MS=3000
SLOW_QUERY_EMAIL=

# ---------------------------------------------------------------------------
# Integrations
# ---------------------------------------------------------------------------
CRM_MOCK_MODE=true

# ---------------------------------------------------------------------------
# Update Checker (In-App Notifications)
# ---------------------------------------------------------------------------
UPDATE_CHECK_ENABLED=true
UPDATE_CHECK_URL=https://raw.githubusercontent.com/cisco00/rag-ai-agent/main/VERSION
UPDATE_CHECK_INTERVAL_HOURS=6
CHANGELOG_URL=https://github.com/cisco00/rag-ai-agent/blob/main/CHANGELOG.md
# GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
ENVIRONMENT=development
# Set to production for deployed environments
